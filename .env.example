# Copy to .env.local for local dev. All values are server-side only.
APP_ROOT_DOMAIN=localhost
APP_ENV=development
TENANTS=acme,globex
# Optional
DEV_HOSTS=
DEV_TENANT_SLUG=
BUILD_ID=local

# Back office: tenants added from admin.<root> are stored in this DynamoDB table.
# Leave TENANTS_TABLE empty to use only TENANTS.
TENANTS_TABLE=test-bo-tenants
TENANTS_TABLE_REGION=ap-southeast-1
# Local only: AWS credentials for the table (run `aws sso login --profile ...` first).
AWS_PROFILE=hr101-bo-dev
# Back office login. Admin is disabled when unset.
ADMIN_PASSWORD=change-me
